{
  "name": "modx-mcp",
  "version": "2.0.0",
  "description": "MCP (Model Context Protocol) server for MODX Revolution. Pairs with the modxMCP MODX component to let an AI client read and manage a MODX site. Tools are defined by the site and served to the client as a manifest.",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dampilov94/mcp-component.git"
  },
  "bin": {
    "modx-mcp": "client/index.js"
  },
  "main": "client/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node scripts/test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.15.2"
  },
  "files": [
    "client",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "modx",
    "modx-revolution",
    "ai"
  ],
  "license": "MIT"
}
